#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<long long> a(n);
    long long sum = 0;

    for (int i = 0; i < n; i++) {
        cin >> a[i];
        sum += a[i];
        a[i] = sum;   // replace value with its prefix sum
    }

    for (int i = n - 1; i >= 0; i--) {
        cout << a[i] << " ";
    }
}
