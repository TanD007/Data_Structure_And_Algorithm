#include <bits/stdc++.h>
using namespace std;

int main() {
    int n,m,o;
    cin>>n;
    vector<int> a(n);
    for(int i=0;i<n;i++){
        cin>>a[i];
    }
    cin>>m;
    vector<int> b(m);
    for(int i=0;i<m;i++){
        cin>>b[i];
    }
    cin>>o;
    
    a.insert(a.begin()+o,b.begin(),b.end());
    for(int i:a) cout << i <<" ";

    return 0;
}
